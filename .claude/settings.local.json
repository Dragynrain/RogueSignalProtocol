{
  "permissions": {
    "allow": [
      "Read(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./**/*.py)",
      "Read(./**/*.json)",
      "Edit(./**/*.json)",
      "Write(./**/*.json)",
      "Read(./**/*.md)",
      "Edit(./**/*.md)",
      "Write(./**/*.md)",
      "Read(./**/*.txt)",
      "Edit(./**/*.txt)",
      "Write(./**/*.txt)",
      "Read(./game_debug.log)",
      "Read(./user_settings.json)",
      "Grep(*)",
      "Glob(*)",
      "MultiEdit(./**/*.py)",
      "MultiEdit(./**/*.json)",
      "TodoWrite(*)",
      "Timeout(*)",
	  "Bash(dir:*)",
      "Bash(.venv\\Scripts\\:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash:*",
	  "Bash(uv run:*)",
      "Bash(uv:*)",
	  "Bash(uv run pytest tests/ -v --tb=short)",
      "WebFetch(domain:docs.claude.com)",
      "Fetch(domain:docs.claude.com)",
      "Bash(find:*)",
      "Bash(uv run pytest :*)",
      "Bash(uv run pytest tests:*)",	  
      "Bash(uv run pytest:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git add :*)",
      "Bash(git commit :*)",
      "Bash(git push :*)",
      "Bash(pip install :*)",
      "Bash(npm install :*)",
      "Write(./requirements.txt)",
      "Edit(./requirements.txt)",
      "Bash(.venv/Scripts/pip.exe uninstall :*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "./.claude/",
      "./artifacts/",
      "./dist/"
    ]
  }
}