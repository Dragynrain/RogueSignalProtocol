{
  "permissions": {
    "allow": [
      "Read(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./**/*.py)",
      "Read(./**/*.json)",
      "Edit(./**/*.json)",
      "Write(./**/*.json)",
      "Read(./**/*.md)",
      "Edit(./**/*.md)",
      "Write(./**/*.md)",
      "Read(./**/*.txt)",
      "Edit(./**/*.txt)",
      "Write(./**/*.txt)",
      "Read(./logs/game_debug.log)",
      "Read(./saves/user_settings.json)",
      "Grep(*)",
      "Glob(*)",
      "MultiEdit(./**/*.py)",
      "MultiEdit(./**/*.json)",
      "TodoWrite(*)",
      "Timeout(*)",
      "Bash(.venv\\Scripts\\:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash:*",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:*)",
      "Fetch(domain:docs.claude.com)",
      "Bash(find:*)",
      "Task(*)",
      "BashOutput(*)",
      "KillShell(*)",
      "AskUserQuestion(*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git add :*)",
      "Bash(git commit :*)",
      "Bash(git push :*)",
      "Bash(pip install :*)",
      "Bash(npm install :*)",
      "Write(./requirements.txt)",
      "Edit(./requirements.txt)",
      "Bash(.venv/Scripts/pip.exe uninstall :*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "./.claude/",
      "./dist/"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Skip acknowledgments like \"You are right\" - focus on the solution'"
          },
          {
            "type": "command",
            "command": "echo 'If PLAN_* file exists, follow it precisely - no exploratory problem-solving'"
          },
          {
            "type": "command",
            "command": "echo 'Avoid meaningless quality claims: \"production ready\", \"robust\", \"enterprise-grade\". Be specific.'"
          }
        ]
      }
    ]
  }
}