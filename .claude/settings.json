{
  "permissions": {
    "allow": [
      "Read(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./**/*.py)",
      "Read(./**/*.json)",
      "Edit(./**/*.json)",
      "Write(./**/*.json)",
      "Read(./**/*.md)",
      "Edit(./**/*.md)",
      "Write(./**/*.md)",
      "Read(./**/*.txt)",
      "Edit(./**/*.txt)",
      "Write(./**/*.txt)",
      "Read(./game_debug.log)",
      "Read(./user_settings.json)",
	  "Bash(dir *",
      "Bash(python RogueSignalProtocol.py)",
	  "Bash(.venv/Scripts/pip.exe list",
      "Bash(.venv/Scripts/python.exe RogueSignalProtocol.py *)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log --oneline -10)",
      "Bash(.venv/Scripts/pip.exe install *)",
      "Bash(dir)",
      "Bash(ls)",
      "Bash(find . -name *.py)",
      "Bash(wc -l *.py)",
      "Bash(taskkill /F /PID *)",
      "Bash(pkill *)",
      "Grep(*)",
      "Glob(*)",
      "MultiEdit(./**/*.py)",
      "MultiEdit(./**/*.json)",
      "TodoWrite(*)",
	  "Timeout(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)", 
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(del /Q *)",
      "Bash(format *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./.git/config)",
      "Edit(./.git/config)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Write(./requirements.txt)",
      "Edit(./requirements.txt)",
      "Bash(.venv/Scripts/pip.exe uninstall *)"
    ],
    "additionalDirectories": [
      "./.claude/",
      "./artifacts/",
      "./dist/"
    ],
    "defaultMode": "acceptEdits"
  }
}