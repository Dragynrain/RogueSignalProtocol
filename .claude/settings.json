{
  "permissions": {
    "allow": [
      "Read(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./**/*.py)",
      "Read(./**/*.json)",
      "Edit(./**/*.json)",
      "Write(./**/*.json)",
      "Read(./**/*.md)",
      "Edit(./**/*.md)",
      "Write(./**/*.md)",
      "Read(./**/*.txt)",
      "Edit(./**/*.txt)",
      "Write(./**/*.txt)",
      "Read(./logs/game_debug.log)",
      "Read(./saves/user_settings.json)",
      "Grep(*)",
      "Glob(*)",
      "MultiEdit(./**/*.py)",
      "MultiEdit(./**/*.json)",
      "TodoWrite(*)",
      "Timeout(*)",
      "Bash(.venv\\Scripts\\:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash:*",
      "WebFetch(domain:docs.claude.com)",
      "Fetch(domain:docs.claude.com)",
      "Bash(find:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git add :*)",
      "Bash(git commit :*)",
      "Bash(git push :*)",
      "Bash(pip install :*)",
      "Bash(npm install :*)",
      "Write(./requirements.txt)",
      "Edit(./requirements.txt)",
      "Bash(.venv/Scripts/pip.exe uninstall :*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "./.claude/",
      "./dist/"
    ]
  }
}