{
  "permissions": {
    "allow": [
      "Read(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./**/*.py)",
      "Read(./**/*.json)",
      "Edit(./**/*.json)",
      "Write(./**/*.json)",
      "Read(./**/*.md)",
      "Edit(./**/*.md)",
      "Write(./**/*.md)",
      "Read(./**/*.txt)",
      "Edit(./**/*.txt)",
      "Write(./**/*.txt)",
      "Read(./game_debug.log)",
      "Read(./user_settings.json)",
      "Grep(*)",
      "Glob(*)",
      "MultiEdit(./**/*.py)",
      "MultiEdit(./**/*.json)",
      "TodoWrite(*)",
      "Timeout(*)",
      "Bash(.venv\\Scripts\\:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash:*",
      "Bash(.venv\\Scripts\\python.exe -m pytest)",
      "Bash(.venv\\Scripts\\python.exe -m pytest :*)",
      "Bash(\".venv/Scripts/python.exe\" -m pytest)",
      "Bash(\".venv/Scripts/python.exe\" -m pytest :*)",
      "Bash(.venv\\Scripts\\python.exe :*)",
      "Bash(\".venv/Scripts/python.exe\" :*)",
      "Bash(uv run:*)",
      "WebFetch(domain:docs.claude.com)",
      "Bash(find:*)",
      "Bash(.venvScriptspython.exe -m pytest tests/unit/test_inventory.py::TestInventoryItem::test_inventory_item_use_default -v)",
      "Bash(\".venv\\Scripts\\python.exe\" mutmut_config.py results)",
      "Bash(\".venv\\Scripts\\pip.exe\" list)",
      "Bash(\".venv\\Scripts\\mutmut.exe\" show)",
      "Bash(uv:*)",
      "Bash(\".venv/Scripts/pip.exe\" install uv)",
      "Bash(\".venv/Scripts/uv.exe\" --version)",
      "Bash(\".venv/Scripts/uv.exe\" run python --version)",
      "Bash(\".venv/Scripts/uv.exe\" run pytest --version)",
      "Bash(\".venv/Scripts/uv.exe\" run pytest tests/unit/test_inventory.py::TestInventoryItem::test_inventory_item_use_default -v)",
      "Bash(\".venv/Scripts/uv.exe\" run mutmut --version)",
      "Bash(for f in tests/unit/test_*.py)",
      "Bash(done)",
      "Bash(for f in game_*.py)",
      "Bash(do testname=\"tests/unit/test_$f#game_.py\")",
      "Bash(if [ ! -f \"$testname\" ])",
      "Bash(then echo \"Missing test: $testname for $f\")",
      "Bash(fi)"
    ],
    "deny": [],
    "ask": [
      "Bash(git add :*)",
      "Bash(git commit :*)",
      "Bash(git push :*)",
      "Bash(pip install :*)",
      "Bash(npm install :*)",
      "Write(./requirements.txt)",
      "Edit(./requirements.txt)",
      "Bash(.venv/Scripts/pip.exe uninstall :*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "./.claude/",
      "./artifacts/",
      "./dist/"
    ]
  }
}