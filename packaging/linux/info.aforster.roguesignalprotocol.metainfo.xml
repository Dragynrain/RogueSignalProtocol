  <releases>
    <release version="1.0.0" date="2026-06-01" type="stable">
      <description>
        <p>1.0 release. New prologue tutorial, console window removed on Windows, save system and pathfinding polish, codebase reorganized into src/rsp package.</p>
      </description>
    </release>
    <release version="0.9.2-beta" date="2025-12-30" type="development">
      <description>
