          <li>Fixed victory screen not responding to gamepad input</li>
          <li>Fixed ascension unlock popup not responding to gamepad</li>
          <li>Fixed settings confirmation dialogs for controller users</li>
          <li>Improved debug export path display</li>
        </ul>
      </description>
    </release>
    <release version="0.9.0-beta" date="2025-12-27" type="development">
      <description>
