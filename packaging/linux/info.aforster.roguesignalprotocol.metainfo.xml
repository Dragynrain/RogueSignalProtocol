<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>info.aforster.roguesignalprotocol</id>

  <name>Rogue Signal Protocol</name>
  <summary>Coffee break cyberspace stealth roguelike</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <developer id="info.aforster">
    <name>Adam Forster</name>
  </developer>

  <description>
    <p>
      A turn-based stealth roguelike. You play an escaped digital consciousness
      slipping through hostile corporate networks. Runs take 10-15 minutes and
      end with permadeath.
    </p>
    <p>Features:</p>
    <ul>
      <li>Enemy movement prediction - each enemy shows its next 3 planned moves</li>
      <li>Stealth via blind spots and ambushes (+10 damage from cover)</li>
      <li>13 exploits and 6 code hacks to discover</li>
      <li>47 achievements and 20 Ascension difficulty levels</li>
      <li>Full gamepad support (tested on Steam Deck)</li>
    </ul>
  </description>

  <launchable type="desktop-id">info.aforster.roguesignalprotocol.desktop</launchable>

  <url type="homepage">https://dragynrain.itch.io/rogue-signal-protocol</url>
  <url type="bugtracker">https://github.com/Dragynrain/RogueSignalProtocol/issues</url>

  <provides>
    <binary>rogue-signal-protocol</binary>
  </provides>

  <requires>
    <display_length compare="ge">800</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <supports>
    <control>gamepad</control>
  </supports>

  <categories>
    <category>Game</category>
    <category>RolePlaying</category>
  </categories>

  <keywords>
    <keyword>roguelike</keyword>
    <keyword>cyberpunk</keyword>
    <keyword>tactical</keyword>
    <keyword>turn-based</keyword>
    <keyword>indie</keyword>
    <keyword>permadeath</keyword>
    <keyword>stealth</keyword>
  </keywords>

